# SEO - required for canonical URLs, sitemap, Open Graph
# Production: https://goodparty.org
# Local dev: http://localhost:3009
# In Vercel, paste without trailing spaces or newlines (bad values break canonical URLs).
NEXT_PUBLIC_SITE_URL=

# Storybook deploy - required for `bun run sb:deploy`
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Sanity CMS - required for image URLs and content fetching
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_STUDIO_API_TOKEN=
# Editor (write) token required for: bun run sanity:backfill:experiments
# BACKFILL_STUCK_LOG_MS=5000
# Shared secret for Sanity webhook to trigger on-demand cache revalidation (POST /api/revalidate)
# Paste in Vercel without trailing newlines or webhook signature checks will fail.
SANITY_REVALIDATE_SECRET=

# gp-api base for election, campaign and person-profile reads
# Dev: https://gp-api-dev.goodparty.org
# Production: https://gp-api.goodparty.org (default)
GP_API_BASE_URL=

# Bearer for gp-api's gated reads (SERVER-ONLY — never expose as NEXT_PUBLIC_).
# Leave unset on Vercel and locally: without it the reads send this deployment's
# Vercel OIDC token instead. CI sets it to a GitHub Actions OIDC token (see
# .github/workflows/generate-people-sitemaps.yml). Locally, run `vercel link` then
# `vercel env pull` to get a VERCEL_OIDC_TOKEN for gp-marketing's `development`
# environment, which dev gp-api (GP_API_BASE_URL=https://gp-api-dev.goodparty.org)
# accepts. With neither token the reads go out unauthenticated and gp-api 401s
# them, so /people pages render as removed (noindex).
GP_API_SERVICE_TOKEN=

# Shared secret gp-api sends (header x-revalidate-secret) to POST /api/revalidate-person
# to on-demand cache-bust a public /people/* page after publish/unpublish/delete/edit.
# Must match gp-api's MARKETING_REVALIDATE_SECRET. Paste without trailing newlines.
MARKETING_REVALIDATE_SECRET=

# Ashby job board - required for /work-with-us careers page
# Find your board name from https://jobs.ashbyhq.com/{JOB_BOARD_NAME}
ASHBY_JOB_BOARD_NAME=

# Amplitude Analytics - required for event tracking
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# Amplitude Experiment (server-side remote evaluation) - for CMS-driven A/B experiments
# Server deployment key for the deployment named `gp-marketing` in Amplitude Experiment.
# Production uses the GoodParty.org project's key; Preview and Development use the
# GoodParty Dev project's key. Get it from:
# Amplitude > Experiment > Deployments > gp-marketing
AMPLITUDE_EXPERIMENT_DEPLOYMENT_KEY=

# Google Places API (New) browser key - required for city/county autocomplete on
# the Elections Near You block. Referrer-restricted to this site's origins in the
# GCP console; a browser key is meant to be public, unlike a server key. Do NOT
# reuse gp-api's server-side Google key here. Without this set, the block still
# works: the input submits raw typed text and the resolve route name-matches it
# server-side.
NEXT_PUBLIC_GOOGLE_PLACES_BROWSER_KEY=

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) on the profile request pop-up's
# voter form. Set BOTH or neither: the site key shows the checkbox, the secret makes
# /api/people/claim-request check it with Google. A secret without the site key
# rejects every request. The site key is public; the secret is SERVER-ONLY.
# For local dev, Google publishes test keys that always pass:
# https://developers.google.com/recaptcha/docs/faq#id-like-to-run-automated-tests-with-recaptcha.-what-should-i-do
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
